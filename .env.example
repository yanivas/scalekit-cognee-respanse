PORT=3000

# Scalekit AgentKit
# Select "Connect my agents to MCP tools & APIs (AgentKit)" in Scalekit onboarding.
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_USER_IDENTIFIER=hackathon-demo-user
# Two users make the access story visible. Use real Scalekit identifiers in live mode.
HACKATHON_USERS=alice@acme.example,bob@acme.example
SCALEKIT_SLACK_CONNECTION=slack
SCALEKIT_JIRA_CONNECTION=jira
SCALEKIT_GITHUB_CONNECTION=github

# Tool names are discoverable in Scalekit > AgentKit > Connections.
# These defaults are intentionally editable because connector variants can differ.
SCALEKIT_SLACK_HISTORY_TOOL=slack_fetch_conversation_history
SCALEKIT_SLACK_SEND_TOOL=slack_send_message
SCALEKIT_JIRA_CREATE_TOOL=jira_issue_create
SCALEKIT_JIRA_GET_TOOL=jira_issue_get
SCALEKIT_GITHUB_PR_TOOL=github_pull_request_create
SCALEKIT_GITHUB_FILE_TOOL=github_file_contents_get
SCALEKIT_GITHUB_ISSUES_TOOL=github_issues_list

# Demo target systems
SLACK_WORKSPACE_NAME=hackathon
SLACK_CHANNEL_NAME=all-hackathon
SLACK_CHANNEL_ID=C0C74K67AAK
JIRA_PROJECT_KEY=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_CONTEXT_PATH=README.md

# Memory. Keep "local" for table demos; set "cognee" after installing Cognee.
MEMORY_PROVIDER=local
COGNEE_PYTHON_BIN=python3
COGNEE_DATASET_PREFIX=company-brain
ENABLE_BACKEND_ACCESS_CONTROL=false
COGNEE_DEMO_PASSWORD=hackathon-pw
# Cognee requires absolute paths for these directories.
DATA_ROOT_DIRECTORY=/absolute/path/to/hackathon/.cognee-data/data
SYSTEM_ROOT_DIRECTORY=/absolute/path/to/hackathon/.cognee-data/system
CACHE_ROOT_DIRECTORY=/absolute/path/to/hackathon/.cognee-data/cache
COGNEE_LOGS_DIR=/absolute/path/to/hackathon/.cognee-data/logs
COGNEE_REPOS_DIR=/absolute/path/to/hackathon/.cognee-data/repos
DB_PATH=/absolute/path/to/hackathon/.cognee-data/system/databases
MIGRATION_DB_PATH=/absolute/path/to/hackathon/.cognee-data/system/databases

# Cognee LLM and embeddings through Respan when MEMORY_PROVIDER=cognee.
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=${RESPAN_API_KEY}
LLM_MODEL=${RESPAN_MODEL}
EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=${RESPAN_API_KEY}
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Respan gateway
RESPAN_API_KEY=
RESPAN_MODEL=gpt-4o-mini
RESPAN_CUSTOMER_IDENTIFIER=hackathon-demo
RESPAN_TRACE_NAME=scalekit-cognee-respanse
# Optional: pin to a provider such as vertex_ai when the model slug supports it.
RESPAN_ROUTE_PROVIDER=

# Set to "real" after Scalekit connections are authorized. "mock" keeps the demo runnable.
CONNECTOR_MODE=mock
